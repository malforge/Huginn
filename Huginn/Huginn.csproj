<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!-- The Windows TFM is only available on Windows hosts. Restoring it on
             Mac/Linux fails (no Windows ref packs) unless EnableWindowsTargeting
             is set; simpler to just exclude it on non-Windows so `dotnet restore`
             on Mac CI runners doesn't trip over a TFM it could never build. -->
        <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net10.0;net10.0-windows10.0.17763.0</TargetFrameworks>
        <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <!-- Version is single-sourced from PackageVersion.txt alongside the csproj.
             Both local builds and CI read from the same file; the version-guard
             workflow enforces that it gets bumped whenever code in this folder
             changes. -->
        <Version Condition="Exists('PackageVersion.txt')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/PackageVersion.txt').Trim())</Version>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.17763.0'">
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\Huginn.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
        <!-- Native libs (libSkiaSharp, libHarfBuzzSharp, av_libglesv2, etc.)
             must be unpacked from the single-file bundle to disk before the
             runtime can P/Invoke them; otherwise startup throws
             DllNotFoundException at Skia init. -->
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>

    <!-- macOS .app bundle metadata. Velopack's vpk pack reads CFBundleName /
         CFBundleIdentifier when assembling the .app on macOS releases. -->
    <PropertyGroup>
        <CFBundleName>Huginn</CFBundleName>
        <CFBundleDisplayName>Huginn</CFBundleDisplayName>
        <CFBundleIdentifier>com.malforge.huginn</CFBundleIdentifier>
        <CFBundleVersion>1.0.0</CFBundleVersion>
        <CFBundleShortVersionString>1.0</CFBundleShortVersionString>
        <CFBundlePackageType>APPL</CFBundlePackageType>
        <NSHighResolutionCapable>true</NSHighResolutionCapable>
    </PropertyGroup>

    <!-- Conditional file inclusion: *.win.cs only on Windows TFM, *.mac.cs only on non-Windows TFM -->
    <ItemGroup>
        <Compile Remove="**\*.win.cs" />
        <Compile Remove="**\*.mac.cs" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)'=='net10.0-windows10.0.17763.0'">
        <Compile Include="**\*.win.cs" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
        <Compile Include="**\*.mac.cs" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.14" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.14" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.14" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.14" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.14">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>

    <!-- Windows-only NuGet packages -->
    <ItemGroup Condition="'$(TargetFramework)'=='net10.0-windows10.0.17763.0'">
        <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    </ItemGroup>

    <!-- Stamp the UTC build time into assembly metadata.
         Used by the existing ADO commit-date update check; will be retired in
         phase 3 when Velopack takes over auto-update. -->
    <PropertyGroup>
        <_BuildTimestamp>$([System.DateTime]::UtcNow.ToString("o"))</_BuildTimestamp>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>BuildTimestamp</_Parameter1>
            <_Parameter2>$(_BuildTimestamp)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
