<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Huginn.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Huginn.Views.BuildCardView"
             x:DataType="models:BuildItem"
             x:Name="root">

    <UserControl.Styles>
        <!--
            The open menu says "this one", so the card it belongs to has to say which one it is.
            The border is always drawn, transparent when closed, so marking it moves nothing.
        -->
        <Style Selector="Border.card">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border.card.menu-open">
            <Setter Property="BorderBrush" Value="#FF7FB2E5"/>
            <Setter Property="Background" Value="#1A7FB2E5"/>
        </Style>
    </UserControl.Styles>

    <Border x:Name="Card" Classes="card" Margin="0,2" Padding="8,6" CornerRadius="4"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <!--
            DockPanel rather than a Grid. The docked buttons take the width they need and the
            filling child is measured against exactly what is left, so a long name trims. A
            Grid star column does not guarantee that, and the name drew over the buttons.
        -->
        <DockPanel LastChildFill="True" ClipToBounds="True">

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center" Margin="12,0,0,0">

                <Button Command="{Binding #root.AcknowledgeCommand}"
                        CommandParameter="{Binding}"
                        IsVisible="{Binding #root.AcknowledgeCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Content="🔔" FontSize="14" Padding="8,4"
                        ToolTip.Tip="{Binding AcknowledgeTooltip}"/>

                <!-- Regular button when no retry -->
                <Button Content="Open in DevOps ↗"
                        IsVisible="{Binding !RetryInProgress}"
                        Command="{Binding #root.OpenCommand}"
                        CommandParameter="{Binding}"/>

                <!-- Split button when retry is in progress -->
                <SplitButton Content="New build ↗"
                             IsVisible="{Binding RetryInProgress}"
                             Command="{Binding #root.OpenRetryCommand}"
                             CommandParameter="{Binding}">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="View failed build"
                                      Command="{Binding #root.OpenCommand}"
                                      CommandParameter="{Binding}"/>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>

                <!-- Getting at the branch and the run from somewhere other than the browser. -->
                <Button x:Name="MoreButton" Content="⋯" FontSize="14" Padding="8,4"
                        ToolTip.Tip="More actions">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Copy the link to this build"
                                      Command="{Binding #root.CopyLinkCommand}"
                                      CommandParameter="{Binding}"/>
                            <MenuItem Header="Copy the branch name"
                                      ToolTip.Tip="{Binding BranchShortName}"
                                      Command="{Binding #root.CopyBranchCommand}"
                                      CommandParameter="{Binding}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding DefinitionName}"
                               FontWeight="SemiBold" FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" FontSize="12" Foreground="#FF4488CC"
                               IsVisible="{Binding RetryInProgress}"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               Text="🔄 building…"/>
                </Grid>
                <Grid ColumnDefinitions="*,*,Auto" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" FontSize="12" Opacity="0.7" Margin="0,0,12,0"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="🌿"/>
                        <Run Text="{Binding BranchShortName}"/>
                    </TextBlock>
                    <TextBlock Grid.Column="1" FontSize="12" Opacity="0.7" Margin="0,0,12,0"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="👤"/>
                        <Run Text="{Binding RequestedBy}"/>
                    </TextBlock>
                    <TextBlock Grid.Column="2" FontSize="12" Opacity="0.7" Text="{Binding Age}"/>
                </Grid>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
