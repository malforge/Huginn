<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Huginn.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Huginn.Views.PrCardView"
             x:DataType="models:PullRequestItem"
             x:Name="root">

    <Border Margin="4" Padding="12" CornerRadius="6"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
            <!-- Title (with Draft tag) -->
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Border IsVisible="{Binding IsDraft}"
                        Background="#33888888" BorderBrush="#88888888" BorderThickness="1"
                        CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="📝 Draft" FontSize="11" Opacity="0.85"/>
                </Border>
                <TextBlock Text="{Binding PullRequestId, StringFormat=#{0}}" FontSize="14"
                           Opacity="0.5" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                        Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Classes="card-action"
                        Command="{Binding #root.AcknowledgeCommand}"
                        CommandParameter="{Binding}"
                        IsVisible="{Binding #root.AcknowledgeCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Content="🔔" FontSize="14"
                        ToolTip.Tip="{Binding AcknowledgeTooltip}"/>
                <Button Classes="card-action"
                        Command="{Binding #root.CopyLinkCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="Copy link to clipboard">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                          Data="M 2 2 L 10 2 L 10 5 M 2 2 L 2 10 L 5 10 M 5 5 L 13 5 L 13 13 L 5 13 Z"/>
                </Button>
                <Button Classes="card-action"
                        Content="Open in DevOps ↗"
                        Command="{Binding #root.OpenCommand}"
                        CommandParameter="{Binding}"/>
            </StackPanel>

            <!-- Repo + Author + Age -->
            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                        Margin="0,4,0,0" Spacing="12">
                <TextBlock FontSize="12" Opacity="0.7">
                    <Run Text="📦"/>
                    <Run Text="{Binding RepositoryName}"/>
                </TextBlock>
                <TextBlock FontSize="12" Opacity="0.7">
                    <Run Text="👤"/>
                    <Run Text="{Binding CreatedByName}"/>
                </TextBlock>
                <TextBlock FontSize="12" Opacity="0.7"
                           Text="{Binding Age}"/>
            </StackPanel>

            <!-- Vote summary + Pipeline status -->
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                <TextBlock Text="{Binding VoteSummary}" FontSize="12" Opacity="0.8"/>
                <StackPanel Orientation="Horizontal" Spacing="4"
                            IsVisible="{Binding HasPipelineStatus}">
                    <TextBlock Text="{Binding PipelineIcon}" FontSize="12"/>
                    <TextBlock Text="{Binding PipelineLabel}" FontSize="12"
                               Opacity="0.8"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
