<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Huginn.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Huginn.Views.PrCardView"
             x:DataType="models:PullRequestItem"
             x:Name="root">

    <UserControl.Styles>
        <!--
            The open menu says "this one", so the card it belongs to has to say which one it is.
            The border is always drawn, so marking it moves nothing.
        -->
        <Style Selector="Border.card.menu-open">
            <Setter Property="BorderBrush" Value="#FF7FB2E5"/>
            <Setter Property="Background" Value="#1A7FB2E5"/>
        </Style>
    </UserControl.Styles>

    <Border x:Name="Card" Classes="card" Margin="4" Padding="12" CornerRadius="6"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <!--
            DockPanel rather than a Grid. The docked buttons take the width they need and the
            filling child is measured against exactly what is left, so a long title trims. A
            Grid star column does not guarantee that, and the title drew over the buttons.
        -->
        <DockPanel LastChildFill="True">

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Top" Margin="12,0,0,0">
                <Button Classes="card-action"
                        Command="{Binding #root.AcknowledgeCommand}"
                        CommandParameter="{Binding}"
                        IsVisible="{Binding #root.AcknowledgeCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Content="🔔" FontSize="14"
                        ToolTip.Tip="{Binding AcknowledgeTooltip}"/>
                <Button Classes="card-action"
                        Command="{Binding #root.CopyLinkCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="Copy link to clipboard">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                          Data="M 2 2 L 10 2 L 10 5 M 2 2 L 2 10 L 5 10 M 5 5 L 13 5 L 13 13 L 5 13 Z"/>
                </Button>
                <Button Classes="card-action"
                        Content="↗"
                        Command="{Binding #root.OpenCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="Open this pull request in Azure DevOps"/>

                <!-- What you reach for when writing about the pull request rather than reading it. -->
                <Button x:Name="MoreButton" Classes="card-action" Content="⋯"
                        ToolTip.Tip="More actions">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="{Binding PullRequestId, StringFormat=Copy the reference !{0}}"
                                      Command="{Binding #root.CopyReferenceCommand}"
                                      CommandParameter="{Binding}"
                                      ToolTip.Tip="How a pull request is written in Azure DevOps. A # there points at a work item instead."/>
                            <MenuItem Header="Copy the title"
                                      Command="{Binding #root.CopyTitleCommand}"
                                      CommandParameter="{Binding}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <StackPanel>
                <!-- Title, behind the draft tag and the number -->
                <Grid ColumnDefinitions="Auto,Auto,*">
                    <Border Grid.Column="0" IsVisible="{Binding IsDraft}"
                            Background="#33888888" BorderBrush="#88888888" BorderThickness="1"
                            CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="📝 Draft" FontSize="11" Opacity="0.85"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding PullRequestId, StringFormat=#{0}}"
                               FontSize="14" Opacity="0.5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>

                <!-- Repo, author, age -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0" FontSize="12" Opacity="0.7" Margin="0,0,12,0"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="📦"/>
                        <Run Text="{Binding RepositoryName}"/>
                    </TextBlock>
                    <TextBlock Grid.Column="1" FontSize="12" Opacity="0.7" Margin="0,0,12,0"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="👤"/>
                        <Run Text="{Binding CreatedByName}"/>
                    </TextBlock>
                    <TextBlock Grid.Column="2" FontSize="12" Opacity="0.7"
                               Text="{Binding Age}"/>
                </Grid>

                <!--
                    Votes, pipeline and the alert note. A Grid rather than a horizontal StackPanel,
                    which hands every child its full desired width and so never trims.
                -->
                <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0" Text="{Binding VoteSummary}" FontSize="12" Opacity="0.8"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="16,0,0,0"
                                IsVisible="{Binding HasPipelineStatus}">
                        <TextBlock Text="{Binding PipelineIcon}" FontSize="12"/>
                        <TextBlock Text="{Binding PipelineLabel}" FontSize="12" Opacity="0.8"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Margin="16,0,0,0" FontSize="12"
                               Text="{Binding #root.AlertNote}"
                               Foreground="{Binding #root.AlertBrush}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding #root.AlertNote,
                                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </Grid>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
