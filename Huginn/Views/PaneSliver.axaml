<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Huginn.Views"
             x:Class="Huginn.Views.PaneSliver"
             x:DataType="views:PaneSliver">
    <!--
        What is left of a pane while another has focus. Clicking it moves focus here; the small
        button hands the room back evenly. Upright beside panes, a strip between stacked ones.
    -->
    <Border Margin="4" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <Panel>
            <!-- Beside the focused pane: the name reads upward, the count above it. -->
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding $parent[views:PaneSliver].IsVertical}">
                <Button Grid.Row="0" Padding="0,6"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        Command="{Binding $parent[views:PaneSliver].RestoreCommand}"
                        AutomationProperties.Name="Show all panes evenly"
                        ToolTip.Tip="Show all panes evenly">
                    <Path Classes="pane-icon" Data="{StaticResource RestorePanesIcon}"/>
                </Button>
                <Button Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top"
                        Background="Transparent" BorderThickness="0" Padding="0,8"
                        Command="{Binding $parent[views:PaneSliver].FocusCommand}"
                        CommandParameter="{Binding $parent[views:PaneSliver].Target}"
                        AutomationProperties.Name="{Binding $parent[views:PaneSliver].Title}"
                        ToolTip.Tip="Give this pane the room instead">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding $parent[views:PaneSliver].Count}" FontSize="11"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                   IsVisible="{Binding $parent[views:PaneSliver].Count, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <LayoutTransformControl HorizontalAlignment="Center">
                            <LayoutTransformControl.LayoutTransform>
                                <RotateTransform Angle="-90"/>
                            </LayoutTransformControl.LayoutTransform>
                            <TextBlock Text="{Binding $parent[views:PaneSliver].Title}" FontSize="12"
                                       FontWeight="SemiBold" Opacity="0.55"/>
                        </LayoutTransformControl>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Between stacked panes: one line, name and count, the restore button at the end. -->
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !$parent[views:PaneSliver].IsVertical}">
                <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="8,6"
                        Command="{Binding $parent[views:PaneSliver].FocusCommand}"
                        CommandParameter="{Binding $parent[views:PaneSliver].Target}"
                        AutomationProperties.Name="{Binding $parent[views:PaneSliver].Title}"
                        ToolTip.Tip="Give this pane the room instead">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding $parent[views:PaneSliver].Title}" FontSize="12"
                                   FontWeight="SemiBold" Opacity="0.55" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding $parent[views:PaneSliver].Count}" FontSize="11"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Padding="8,6"
                        Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                        Command="{Binding $parent[views:PaneSliver].RestoreCommand}"
                        AutomationProperties.Name="Show all panes evenly"
                        ToolTip.Tip="Show all panes evenly">
                    <Path Classes="pane-icon" Data="{StaticResource RestorePanesIcon}"/>
                </Button>
            </Grid>
        </Panel>
    </Border>
</UserControl>
