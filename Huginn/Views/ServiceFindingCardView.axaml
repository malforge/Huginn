<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Huginn.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600"
             x:Class="Huginn.Views.ServiceFindingCardView"
             x:DataType="models:ServiceFinding"
             x:Name="root">

    <UserControl.Styles>
        <!--
            The open menu says "this one", so the card it belongs to has to say which one it is.
            The border is always drawn, transparent when closed, so marking it moves nothing.
        -->
        <Style Selector="Border.card">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border.card.menu-open">
            <Setter Property="BorderBrush" Value="#FF7FB2E5"/>
            <Setter Property="Background" Value="#1A7FB2E5"/>
        </Style>
    </UserControl.Styles>

    <Border x:Name="Card" Classes="card" Margin="0,2" Padding="10,6" CornerRadius="4"
            Opacity="{Binding CardOpacity}"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">

            <TextBlock Grid.Column="0" Text="{Binding KindIcon}" FontSize="16"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Subject}" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.7"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasTrend}">
                    <TextBlock Text="{Binding Spark}" FontSize="12"
                               FontFamily="Consolas,Menlo,monospace"
                               Foreground="#FF7FB2E5" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TrendVerdict}" FontSize="11" Opacity="0.65"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock FontSize="10" Opacity="0.5" IsVisible="{Binding IsMuted}"
                           Text="muted · returns if it gets substantially worse"/>
            </StackPanel>

            <Border Grid.Column="2" IsVisible="{Binding HasFlagReason}"
                    Background="#3344AAFF" BorderBrush="#8844AAFF" BorderThickness="1"
                    CornerRadius="3" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding FlagReason}" FontSize="10" Foreground="#FF3399DD"/>
            </Border>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Content="{Binding MuteIcon}" FontSize="12" Padding="7,3"
                        Command="{Binding #root.MuteCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding MuteTooltip}"/>
                <Button Content="↗" FontSize="12" Padding="7,3"
                        IsVisible="{Binding HasPortalUrl}"
                        Command="{Binding #root.OpenCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="Open the blade for this kind of problem in the Azure portal"/>

                <!--
                    The rarer actions, behind one button. In a menu they get their words back,
                    which a row of glyphs cannot afford, and the row stops changing width as
                    actions come and go.
                -->
                <Button x:Name="MoreButton" Content="⋯" FontSize="12" Padding="7,3"
                        ToolTip.Tip="More actions">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Copy the query behind this"
                                      Command="{Binding #root.CopyQueryCommand}"
                                      CommandParameter="{Binding}"/>
                            <Separator/>
                            <MenuItem Header="Never show this one again"
                                      ToolTip.Tip="{Binding Subject}"
                                      Command="{Binding #root.IgnoreCommand}"
                                      CommandParameter="{Binding}"/>
                            <MenuItem Header="What is being held back…"
                                      Command="{Binding #root.ShowSuppressedCommand}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
