<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Huginn.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600"
             x:Class="Huginn.Views.ServiceFindingCardView"
             x:DataType="models:ServiceFinding"
             x:Name="root">

    <Border Margin="0,2" Padding="10,6" CornerRadius="4"
            Opacity="{Binding CardOpacity}"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">

            <TextBlock Grid.Column="0" Text="{Binding KindIcon}" FontSize="16"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Subject}" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.7"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock FontSize="10" Opacity="0.5" IsVisible="{Binding IsMuted}"
                           Text="muted · returns if it gets substantially worse"/>
            </StackPanel>

            <Border Grid.Column="2" IsVisible="{Binding HasFlagReason}"
                    Background="#3344AAFF" BorderBrush="#8844AAFF" BorderThickness="1"
                    CornerRadius="3" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding FlagReason}" FontSize="10" Foreground="#FF3399DD"/>
            </Border>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Content="{Binding MuteLabel}" FontSize="11"
                        Command="{Binding #root.MuteCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding MuteTooltip}"/>
                <Button Content="Open in portal ↗" FontSize="11"
                        IsVisible="{Binding HasPortalUrl}"
                        Command="{Binding #root.OpenCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="Open the blade for this kind of problem in the Azure portal"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
