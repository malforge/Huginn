<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Huginn.ViewModels"
        xmlns:models="using:Huginn.Models"
        xmlns:views="using:Huginn.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
        x:Class="Huginn.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Huginn.ico"
        Title="Huginn"
        Width="720" Height="520"
        MinWidth="500" MinHeight="350">

    <Window.Resources>
    </Window.Resources>

    <Window.Styles>
        <!-- The settings list. A nav item is a button that looks like a row, so the whole
             row is the target and the selected one keeps its fill under the pointer. -->
        <Style Selector="TextBlock.navgroup">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="Margin" Value="10,14,0,4"/>
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22808080"/>
        </Style>
        <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#333399FF"/>
        </Style>
        <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#443399FF"/>
        </Style>
        <Style Selector="Button.nav TextBlock.navlabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="Button.nav.selected TextBlock.navlabel">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- One settings section. -->
        <Style Selector="TextBlock.pagetitle">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.group">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <Style Selector="TextBlock.fieldlabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="TextBlock.pagenote">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemAltHighColor}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ═══ TOOLBAR ═══ -->
        <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource SystemAltHighColor}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Text="Monitor" FontSize="14" Opacity="0.6"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1" Command="{Binding RestartNowCommand}"
                        IsVisible="{Binding UpdateAvailable}"
                        Margin="0,0,8,0" Padding="8,4" CornerRadius="4"
                        Background="#443399FF" BorderBrush="#883399FF" BorderThickness="1"
                        Cursor="Hand" ToolTip.Tip="A new version is downloaded and ready. Click to install and restart.">
                    <TextBlock Text="Update available" FontSize="12" Foreground="#FF66AAFF"/>
                </Button>

                <Button Grid.Column="2" Command="{Binding RefreshCommand}"
                        Content="⟳ Refresh" Margin="0,0,8,0"
                        IsEnabled="{Binding IsConnected}"
                        ToolTip.Tip="Refresh now"/>

                <Button Grid.Column="3" Command="{Binding ToggleSettingsCommand}"
                        Content="⚙" FontSize="16" Width="36" HorizontalContentAlignment="Center"
                        ToolTip.Tip="Settings"/>
            </Grid>
        </Border>

        <!-- ═══ CONNECTION ERROR BANNER ═══ -->
        <Border Grid.Row="1" IsVisible="{Binding HasConnectionError}"
                Padding="12,8" Background="#44FF2200" BorderBrush="#AAFF2200"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="⚠" FontSize="16" Foreground="#FFCC2200"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding ConnectionError}"
                           FontSize="13" Foreground="#FFCC2200" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="2" Command="{Binding OpenSettingsCommand}"
                        Content="Open Settings" Margin="12,0,0,0" Classes="accent"/>
            </Grid>
        </Border>

        <!-- ═══ SETTINGS PANEL (toggled) ═══
             A list of sections down the left, one section at a time on the right. The list
             carries each source's state, so a connection that needs attention is visible
             without opening anything. -->
        <Border Grid.Row="2" IsVisible="{Binding IsSettingsVisible}"
                ZIndex="10" Background="{DynamicResource SystemRegionColor}">
            <Grid ColumnDefinitions="248,*">

                <!-- ─── Sections ─── -->
                <Border Grid.Column="0" Padding="12,16"
                        Background="{DynamicResource SystemAltHighColor}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0" Text="Settings" FontSize="18" FontWeight="SemiBold"
                                   Margin="10,0,0,8"/>

                        <StackPanel Grid.Row="1" Spacing="1">
                            <TextBlock Classes="navgroup" Text="CONNECTIONS"/>
                            <TextBlock Text="Whichever of these are connected get watched. The rest are left alone."
                                       FontSize="10" Opacity="0.45" TextWrapping="Wrap"
                                       Margin="10,0,4,4"/>

                            <Button Classes="nav" Classes.selected="{Binding IsAdoPage}"
                                    Command="{Binding ShowSettingsPageCommand}"
                                    CommandParameter="{x:Static models:SettingsPage.AzureDevOps}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="navlabel" Text="Azure DevOps"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AdoStatus.Glyph}" FontSize="12"
                                               VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding AdoStatus.StateText}"/>
                                </Grid>
                            </Button>

                            <Button Classes="nav" Classes.selected="{Binding IsSentryPage}"
                                    Command="{Binding ShowSettingsPageCommand}"
                                    CommandParameter="{x:Static models:SettingsPage.Sentry}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="navlabel" Text="Sentry"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SentryStatus.Glyph}" FontSize="12"
                                               VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding SentryStatus.StateText}"/>
                                </Grid>
                            </Button>

                            <Button Classes="nav" Classes.selected="{Binding IsAppInsightsPage}"
                                    Command="{Binding ShowSettingsPageCommand}"
                                    CommandParameter="{x:Static models:SettingsPage.AppInsights}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="navlabel" Text="Application Insights"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AppInsightsStatus.Glyph}" FontSize="12"
                                               VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding AppInsightsStatus.StateText}"/>
                                </Grid>
                            </Button>

                            <TextBlock Classes="navgroup" Text="MONITORING"/>

                            <Button Classes="nav" Classes.selected="{Binding IsHeldBackPage}"
                                    Command="{Binding ShowSettingsPageCommand}"
                                    CommandParameter="{x:Static models:SettingsPage.HeldBack}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="navlabel" Text="Held back"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SuppressedCount, StringFormat={}{0:N0}}"
                                               FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                                               ToolTip.Tip="Kept off the board on the last check"/>
                                </Grid>
                            </Button>

                            <Button Classes="nav" Classes.selected="{Binding IsAgentsPage}"
                                    Command="{Binding ShowSettingsPageCommand}"
                                    CommandParameter="{x:Static models:SettingsPage.Agents}">
                                <TextBlock Classes="navlabel" Text="Agents"/>
                            </Button>

                            <TextBlock Classes="navgroup" Text="APPLICATION"/>

                            <Button Classes="nav" Classes.selected="{Binding IsUpdatesPage}"
                                    Command="{Binding ShowSettingsPageCommand}"
                                    CommandParameter="{x:Static models:SettingsPage.Updates}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="navlabel" Text="Updates"/>
                                    <TextBlock Grid.Column="1" Text="●" FontSize="11" Foreground="#FF66AAFF"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding UpdateAvailable}"
                                               ToolTip.Tip="A new version is ready to install"/>
                                </Grid>
                            </Button>

                            <Button Classes="nav" Classes.selected="{Binding IsGeneralPage}"
                                    Command="{Binding ShowSettingsPageCommand}"
                                    CommandParameter="{x:Static models:SettingsPage.General}">
                                <TextBlock Classes="navlabel" Text="General"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="8" Margin="2,12,2,0">
                            <TextBlock Text="Changes are saved when you close settings."
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                            <Button Command="{Binding ToggleSettingsCommand}" Content="Done"
                                    Classes="accent" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ─── The selected section ─── -->
                <ScrollViewer Grid.Column="1" Padding="28,20"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Panel MaxWidth="1100" HorizontalAlignment="Left">

                        <!-- ─── Azure DevOps ─── -->
                        <StackPanel IsVisible="{Binding IsAdoPage}" Spacing="8">
                            <TextBlock Classes="pagetitle" Text="Azure DevOps"/>
                            <TextBlock Classes="pagenote"
                                       Text="Pull requests waiting on you, and the pipelines you care about. The token is yours, so Huginn sees exactly what you see."/>

                            <Grid ColumnDefinitions="*,24,*" Margin="0,8,0,0">
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Classes="group" Text="Connection"/>

                                    <TextBlock Classes="fieldlabel" Text="Organization"/>
                                    <TextBox Text="{Binding Organization}" PlaceholderText="e.g. contoso"/>

                                    <TextBlock Classes="fieldlabel" Text="Project"/>
                                    <TextBox Text="{Binding Project}" PlaceholderText="e.g. fabrikam"/>

                                    <TextBlock Classes="fieldlabel" Text="Personal Access Token"/>
                                    <Border Classes="card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="How to create a PAT:" FontSize="12" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Spacing="0">
                                                <TextBlock FontSize="12" Text="1. "/>
                                                <Button Command="{Binding OpenPatPageCommand}"
                                                        Padding="0" Margin="0" MinHeight="0" MinWidth="0"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                    <TextBlock FontSize="12" Text="Open the token settings page ↗"
                                                               Foreground="#648CB4" TextDecorations="Underline"/>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="2. Click &apos;New Token&apos;"/>
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="3. Give it a name (e.g. &apos;Huginn&apos;)"/>
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="4. Under Scopes, select Code → Read and Build → Read"/>
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="5. Click Create and paste the token below"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBox Text="{Binding Pat}" PlaceholderText="Paste your PAT here"
                                             PasswordChar="●" RevealPassword="False"/>

                                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,4,0,0">
                                        <Button Grid.Column="0" Command="{Binding TestConnectionCommand}"
                                                CommandParameter="{x:Static models:ConnectionKind.AzureDevOps}"
                                                IsEnabled="{Binding !AdoStatus.IsBusy}"
                                                Content="Test connection"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AdoStatus.Glyph}" FontSize="14"
                                                   VerticalAlignment="Center" Margin="10,0,6,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding AdoStatus.StateText}" FontSize="12"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.9"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Classes="group" Text="What to watch"/>

                                    <CheckBox IsChecked="{Binding MonitorMyBuilds}">
                                        <TextBlock Text="Notify me when my builds fail" TextWrapping="Wrap"/>
                                    </CheckBox>

                                    <TextBlock Text="Pipelines" FontSize="12" FontWeight="SemiBold"
                                               Opacity="0.8" Margin="0,8,0,0"/>
                                    <TextBlock Classes="pagenote" Text="Get alerted when these pipelines fail:"/>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Command="{Binding LoadPipelinesCommand}" Content="⟳"
                                                FontSize="14" Width="32" HorizontalContentAlignment="Center"
                                                IsEnabled="{Binding !IsLoadingPipelines}"
                                                ToolTip.Tip="Refresh pipeline list"/>
                                        <TextBlock Text="{Binding PipelinePickerStatus}" FontSize="12"
                                                   VerticalAlignment="Center" Opacity="0.7"
                                                   ToolTip.Tip="{Binding PipelinePickerTooltip}"/>
                                    </StackPanel>

                                    <TextBox Text="{Binding PipelineFilter}" PlaceholderText="🔍 Filter pipelines…"
                                             IsVisible="{Binding AvailablePipelines.Count}"/>

                                    <Border MaxHeight="360" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="4"
                                            IsVisible="{Binding AvailablePipelines.Count}">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding FilteredPipelines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SelectablePipeline">
                                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="8,2" Padding="4,0">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- ─── Sentry ─── -->
                        <StackPanel IsVisible="{Binding IsSentryPage}" Spacing="8">
                            <TextBlock Classes="pagetitle" Text="Sentry"/>
                            <TextBlock Classes="pagenote"
                                       Text="Crashes from the mobile apps. An issue is raised when it is new, when it has come back, or when it has reached enough people to matter."/>

                            <Grid ColumnDefinitions="*,24,*" Margin="0,8,0,0">
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Classes="group" Text="Connection"/>

                                    <TextBlock Classes="fieldlabel" Text="Organization"/>
                                    <TextBox Text="{Binding SentryOrganization}" PlaceholderText="e.g. contoso-as"/>

                                    <TextBlock Classes="fieldlabel" Text="Region URL"/>
                                    <TextBox Text="{Binding SentryRegionUrl}" PlaceholderText="https://sentry.io"/>
                                    <TextBlock Classes="pagenote"
                                               Text="EU-resident organisations answer on https://de.sentry.io. The org settings page shows which region yours is in."/>

                                    <TextBlock Classes="fieldlabel" Text="Auth token"/>
                                    <Border Classes="card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="How to create a token:" FontSize="12" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Spacing="0">
                                                <TextBlock FontSize="12" Text="1. "/>
                                                <Button Command="{Binding OpenSentryTokenPageCommand}"
                                                        Padding="0" Margin="0" MinHeight="0" MinWidth="0"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                    <TextBlock FontSize="12" Text="Open the auth tokens page ↗"
                                                               Foreground="#648CB4" TextDecorations="Underline"/>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="2. Click &apos;Create New Token&apos;"/>
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="3. Give it a name (e.g. &apos;Huginn&apos;)"/>
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="4. Under Scopes, select org:read, project:read and event:read"/>
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="5. Click Create and paste the token below"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBox Text="{Binding SentryToken}" PlaceholderText="Paste your Sentry token here"
                                             PasswordChar="●" RevealPassword="False"/>

                                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,4,0,0">
                                        <Button Grid.Column="0" Command="{Binding TestConnectionCommand}"
                                                CommandParameter="{x:Static models:ConnectionKind.Sentry}"
                                                IsEnabled="{Binding !SentryStatus.IsBusy}"
                                                Content="Test connection"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SentryStatus.Glyph}" FontSize="14"
                                                   VerticalAlignment="Center" Margin="10,0,6,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SentryStatus.StateText}" FontSize="12"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.9"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Classes="group" Text="What to watch"/>
                                    <TextBlock Classes="pagenote"
                                               Text="Alert on new and returning issues in these projects. Nothing is watched until you tick something."/>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Command="{Binding LoadSentryProjectsCommand}" Content="⟳"
                                                FontSize="14" Width="32" HorizontalContentAlignment="Center"
                                                IsEnabled="{Binding !IsLoadingSentryProjects}"
                                                ToolTip.Tip="Refresh the project list"/>
                                        <TextBlock Text="{Binding SentryProjectPickerStatus}" FontSize="12"
                                                   VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Border MinHeight="60" MaxHeight="360"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="4">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding AvailableSentryProjects}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SelectableSentryProject">
                                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="8,2" Padding="4,0">
                                                            <TextBlock Text="{Binding Slug}" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- ─── Application Insights ─── -->
                        <StackPanel IsVisible="{Binding IsAppInsightsPage}" Spacing="8">
                            <TextBlock Classes="pagetitle" Text="Application Insights"/>
                            <TextBlock Classes="pagenote"
                                       Text="Server telemetry: routes that are failing, routes that have gone slow, and the dependencies letting them down."/>

                            <Grid ColumnDefinitions="*,24,*" Margin="0,8,0,0">
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Classes="group" Text="Sign-in"/>

                                    <Border Classes="card">
                                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                                   Text="Sign in with your own Azure account. Huginn then lists only the Application Insights resources you personally have access to, so nothing here is shared between people. Sign-in opens your system default browser and waits for it to come back, so complete it there rather than reopening the link elsewhere."/>
                                    </Border>

                                    <TextBlock FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                                               IsVisible="{Binding AppInsightsAccount, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Run Text="Signed in as"/>
                                        <Run Text="{Binding AppInsightsAccount}" FontWeight="SemiBold"/>
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <Button Command="{Binding SignInToAzureCommand}"
                                                IsEnabled="{Binding !AppInsightsStatus.IsBusy}"
                                                Content="Sign in…" Classes="accent"/>
                                        <Button Command="{Binding CancelAzureSignInCommand}"
                                                IsEnabled="{Binding AppInsightsStatus.IsBusy}"
                                                Content="Cancel"
                                                ToolTip.Tip="Stop waiting for the browser to come back"/>
                                        <Button Command="{Binding SignOutOfAzureCommand}"
                                                IsEnabled="{Binding AppInsightsAccount, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Content="Sign out"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,4,0,0">
                                        <Button Grid.Column="0" Command="{Binding TestConnectionCommand}"
                                                CommandParameter="{x:Static models:ConnectionKind.AppInsights}"
                                                IsEnabled="{Binding !AppInsightsStatus.IsBusy}"
                                                Content="Test connection"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AppInsightsStatus.Glyph}" FontSize="14"
                                                   VerticalAlignment="Center" Margin="10,0,6,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding AppInsightsStatus.StateText}" FontSize="12"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.9"/>
                                    </Grid>

                                    <Expander Header="Advanced" HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch" Margin="0,8,0,0">
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <TextBlock Classes="pagenote"
                                                       Text="Leave both of these empty unless someone has told you otherwise. Signing in without them uses the account and tenant you normally log in with."/>

                                            <TextBlock Classes="fieldlabel" Text="Tenant ID"/>
                                            <TextBox Text="{Binding AppInsightsTenantId}"
                                                     PlaceholderText="empty: your usual tenant"/>
                                            <TextBlock Classes="pagenote"
                                                       Text="Only needed to reach a tenant you are not normally signed in to."/>

                                            <TextBlock Classes="fieldlabel" Text="Application (client) ID"/>
                                            <TextBox Text="{Binding AppInsightsClientId}"
                                                     PlaceholderText="empty: the built-in Azure sign-in app"/>
                                            <TextBlock Classes="pagenote"
                                                       Text="Only needed if sign-in is refused because the built-in app is not approved, in which case paste your own app registration id."/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Classes="group" Text="What to watch"/>
                                    <TextBlock Classes="pagenote" Text="Watch these resources for failures and slowdowns:"/>

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,4">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Classes="fieldlabel" Text="Look back over"/>
                                            <TextBlock Classes="pagenote"
                                                       Text="Short reacts quickly but is noisy on low traffic. Long is steadier but slower to notice."/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="150" FontSize="12"
                                                  VerticalAlignment="Center" Margin="8,0,0,0"
                                                  ItemsSource="{Binding WindowChoices}"
                                                  SelectedItem="{Binding SelectedWindow}"
                                                  ToolTip.Tip="How much history each rule examines"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Command="{Binding LoadComponentsCommand}" Content="⟳"
                                                FontSize="14" Width="32" HorizontalContentAlignment="Center"
                                                IsEnabled="{Binding !IsLoadingComponents}"
                                                ToolTip.Tip="Refresh the resource list"/>
                                        <TextBlock Text="{Binding ComponentPickerStatus}" FontSize="12"
                                                   VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <TextBox Text="{Binding ComponentFilter}" PlaceholderText="🔍 Filter resources…"
                                             IsVisible="{Binding AvailableComponents.Count}"/>

                                    <Border MaxHeight="360" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="4"
                                            IsVisible="{Binding AvailableComponents.Count}">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding FilteredComponents}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SelectableComponent">
                                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="8,2" Padding="4,0">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Qualifier}" FontSize="10" Opacity="0.5"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- ─── Held back ─── -->
                        <StackPanel IsVisible="{Binding IsHeldBackPage}" Spacing="8">
                            <TextBlock Classes="pagetitle" Text="Held back"/>
                            <TextBlock Classes="pagenote"
                                       Text="An internet-facing resource is scanned constantly, and scanning means asking for paths that do not exist. Huginn holds those back so they cannot bury a real failure, and lists them here so nothing is hidden without you being able to see it."/>

                            <TextBlock Text="{Binding SuppressedSummary}" FontSize="13"
                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <Grid ColumnDefinitions="*,24,*" Margin="0,8,0,0">
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Classes="group" Text="Kept off the board"/>
                                    <TextBlock Classes="pagenote"
                                               Text="If something of yours is here, it is a real failure being missed. Show it again, and raise it with whoever owns the route rather than leaving it hidden."/>

                                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="4" MinHeight="80" MaxHeight="420">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="8">
                                            <TextBlock Text="Nothing held back on the last check."
                                                       Classes="pagenote"
                                                       IsVisible="{Binding !SuppressedSubjects.Count}"/>
                                            <ItemsControl ItemsSource="{Binding SuppressedSubjects}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:IgnoredSubject">
                                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,3">
                                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Subject}" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Pattern}" FontSize="10"
                                                                           Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" FontSize="11" Opacity="0.7"
                                                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                                                       Text="{Binding Calls, StringFormat={}{0:N0} calls}"/>
                                                            <Button Grid.Column="2" Content="Show" FontSize="11" Padding="8,2"
                                                                    Margin="0,0,4,0" VerticalAlignment="Center"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AlwaysShowCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="Report this from now on, whatever the rules say"/>
                                                            <Button Grid.Column="3" Content="Never" FontSize="11" Padding="8,2"
                                                                    VerticalAlignment="Center"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NeverShowCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="Hide this one by a rule of its own, so it stays gone"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Classes="group" Text="Never show these"/>
                                    <TextBlock Classes="pagenote"
                                               Text="Patterns matched against the route or dependency name. * stands for any run of characters. Different from muting, which is for something of yours you have chosen to live with."/>

                                    <ItemsControl ItemsSource="{Binding IgnoredPatterns}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <TextBlock Grid.Column="0" Text="{Binding}" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Consolas,Menlo,monospace"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="1" Content="✕" FontSize="11" Padding="6,1"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveIgnorePatternCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Stop hiding anything matching this"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <TextBox Grid.Column="0" Margin="0,0,6,0"
                                                 Text="{Binding NewIgnorePattern}"
                                                 PlaceholderText="e.g. */admin/*"/>
                                        <Button Grid.Column="1" Content="Add"
                                                Command="{Binding AddIgnorePatternCommand}"/>
                                    </Grid>

                                    <TextBlock Classes="group" Text="Always shown" Margin="0,16,0,0"/>
                                    <TextBlock Classes="pagenote"
                                               Text="Promoted past every rule above, including the one that holds back scanner traffic."/>

                                    <TextBlock Classes="pagenote" Text="Nothing promoted yet."
                                               IsVisible="{Binding !AlwaysShownSubjects.Count}"/>

                                    <ItemsControl ItemsSource="{Binding AlwaysShownSubjects}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <TextBlock Grid.Column="0" Text="{Binding}" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Consolas,Menlo,monospace"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="1" Content="✕" FontSize="11" Padding="6,1"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StopAlwaysShowingCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Let the rules apply to this again"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- ─── Agents ─── -->
                        <StackPanel IsVisible="{Binding IsAgentsPage}" Spacing="8">
                            <TextBlock Classes="pagetitle" Text="Agents"/>
                            <TextBlock Classes="pagenote"
                                       Text="Huginn can answer an AI coding agent asking what is currently broken, over MCP. It serves what the dashboard already shows, so this needs no extra sign-in and opens no network port."/>

                            <Grid ColumnDefinitions="*,24,*" Margin="0,8,0,0">
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Classes="group" Text="Claude Code"/>

                                    <TextBlock FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                                               Text="{Binding AgentRegistrationStatus}"/>

                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding ClaudeCodeFound}">
                                        <Button IsEnabled="{Binding !AgentBusy}"
                                                IsVisible="{Binding AgentNeedsPointing}"
                                                Command="{Binding RegisterAgentCommand}"
                                                Content="{Binding AgentRegisterLabel}"
                                                ToolTip.Tip="Writes your Claude Code configuration, for your user rather than this folder. Replaces any existing huginn entry."/>
                                        <Button IsEnabled="{Binding !AgentBusy}"
                                                IsVisible="{Binding AgentRegistered}"
                                                Command="{Binding UnregisterAgentCommand}"
                                                Content="Remove"
                                                ToolTip.Tip="Removes the huginn entry from your Claude Code configuration."/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Classes="group" Text="Setting it up by hand"/>
                                    <TextBlock Classes="pagenote"
                                               Text="Everything an MCP client needs is below, for a different agent or when the button will not do."/>

                                    <Border Classes="card">
                                        <StackPanel Spacing="8">
                                            <TextBlock Classes="fieldlabel" Text="Command"/>
                                            <SelectableTextBlock Text="{Binding AgentExecutablePath}" FontSize="11"
                                                                 FontFamily="Consolas,Menlo,monospace" TextWrapping="Wrap"/>

                                            <TextBlock Classes="fieldlabel" Text="Arguments"/>
                                            <SelectableTextBlock Text="--mcp" FontSize="11"
                                                                 FontFamily="Consolas,Menlo,monospace"/>

                                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                                <TextBlock Grid.Column="0" Classes="fieldlabel"
                                                           Text="Claude Code, from a terminal" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="Copy" FontSize="11" Padding="8,2"
                                                        Command="{Binding CopyAgentCommandCommand}"/>
                                            </Grid>
                                            <SelectableTextBlock Text="{Binding AgentCliCommand}" FontSize="11"
                                                                 FontFamily="Consolas,Menlo,monospace" TextWrapping="Wrap"/>

                                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                                <TextBlock Grid.Column="0" Classes="fieldlabel"
                                                           Text="Any other MCP client" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="Copy" FontSize="11" Padding="8,2"
                                                        Command="{Binding CopyAgentConfigCommand}"/>
                                            </Grid>
                                            <SelectableTextBlock Text="{Binding AgentConfigJson}" FontSize="11"
                                                                 FontFamily="Consolas,Menlo,monospace" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- ─── Updates ─── -->
                        <StackPanel IsVisible="{Binding IsUpdatesPage}" Spacing="8" MaxWidth="560"
                                    HorizontalAlignment="Left">
                            <TextBlock Classes="pagetitle" Text="Updates"/>
                            <TextBlock Classes="pagenote"
                                       Text="Huginn looks for a new version on its own. Installing one restarts it."/>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,4">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Classes="fieldlabel" Text="Running version"/>
                                    <TextBlock Text="{Binding CurrentVersionText}" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding CheckForUpdatesCommand}"
                                        IsEnabled="{Binding CanCheckForUpdates}"
                                        Content="Check for updates" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Classes="card">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding UpdateStatusLabel}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border IsVisible="{Binding UpdateAvailable}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="12" Margin="0,8,0,0" MaxHeight="300">
                                <Grid RowDefinitions="Auto,*">
                                    <TextBlock Grid.Row="0" Text="What's new" FontSize="12" FontWeight="SemiBold"
                                               Opacity="0.7" Margin="0,0,0,6"/>
                                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock Text="{Binding ReleaseNotesText}" FontSize="12" TextWrapping="Wrap"
                                                   FontFamily="Consolas,Menlo,monospace"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Button IsVisible="{Binding UpdateAvailable}"
                                    Command="{Binding RestartNowCommand}"
                                    Content="Install update and restart now" Classes="accent"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- ─── General ─── -->
                        <StackPanel IsVisible="{Binding IsGeneralPage}" Spacing="8" MaxWidth="560"
                                    HorizontalAlignment="Left">
                            <TextBlock Classes="pagetitle" Text="General"/>

                            <CheckBox IsChecked="{Binding AutoStartEnabled}" Margin="0,8,0,0">
                                <TextBlock Text="Launch Huginn at login" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock Classes="pagenote"
                                       Text="Watching starts when you log in rather than when you remember to open it."/>
                        </StackPanel>
                    </Panel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══ PANES ═══
             One pane per concern, in as many columns as the window allows: one when
             narrow, four when maximised. Each scrolls on its own, so a long list in
             one pane cannot push another off the screen. -->
        <UniformGrid Grid.Row="2" IsVisible="{Binding !IsSettingsVisible}"
                     Columns="{Binding LayoutColumns}">
                <!-- Pull requests and builds share a column: neither ever runs to many rows, and the width they give back goes to crashes and services. -->
                <Grid RowDefinitions="*,Auto">
                    <Border Grid.Row="0" Margin="4" Padding="2" CornerRadius="6"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0" Text="PULL REQUESTS" FontSize="12"
                                   FontWeight="SemiBold" Opacity="0.55"
                                   Margin="8,6,8,4"/>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                            <!-- 🔴 1. Failed validation (highest priority) -->
                            <Border IsVisible="{Binding HasFailedValidation}" Margin="4" Padding="10" CornerRadius="6"
                                    Background="#44FF2200" BorderBrush="#AAFF2200" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="❌ Failed validation" FontWeight="SemiBold" FontSize="14"
                                               Foreground="#FFCC2200"/>
                                    <ItemsControl ItemsSource="{Binding FailedValidationPrs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:PullRequestItem">
                                                <views:PrCardView DataContext="{Binding}"
                                                                  AlertNote="{Binding PipelineLabel}"
                                                                  AlertBrush="#FFCC2200"
                                                                  OpenCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenInBrowserCommand}"
                                                                  AcknowledgeCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).TogglePrAcknowledgedCommand}"
                                                                  CopyLinkCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPrLinkCommand}"
                                                                  CopyReferenceCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPrReferenceCommand}"
                                                                  CopyTitleCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPrTitleCommand}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 🟠 2. Unstaffed PRs -->
                            <Border IsVisible="{Binding HasUnstaffedPrs}" Margin="4" Padding="10" CornerRadius="6"
                                    Background="#44FF8800" BorderBrush="#AAFF8800" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="⚠ Your PRs missing reviewers" FontWeight="SemiBold" FontSize="14"
                                               Foreground="#FFDD6600"/>
                                    <ItemsControl ItemsSource="{Binding UnstaffedPrs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:PullRequestItem">
                                                <views:PrCardView DataContext="{Binding}"
                                                                  AlertNote="No reviewers assigned"
                                                                  AlertBrush="#FFDD6600"
                                                                  OpenCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenInBrowserCommand}"
                                                                  AcknowledgeCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).TogglePrAcknowledgedCommand}"
                                                                  CopyLinkCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPrLinkCommand}"
                                                                  CopyReferenceCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPrReferenceCommand}"
                                                                  CopyTitleCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPrTitleCommand}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 🟠 3. My PRs without autocomplete (risk of being forgotten) -->
                            <Border IsVisible="{Binding HasAutoCompleteOffPrs}" Margin="4" Padding="10" CornerRadius="6"
                                    Background="#44FF8800" BorderBrush="#AAFF8800" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="⚠ Your PRs without autocomplete" FontWeight="SemiBold" FontSize="14"
                                               Foreground="#FFDD6600"
                                               ToolTip.Tip="These PRs aren't set to autocomplete — they won't merge automatically when policies pass, so they risk being forgotten."/>
                                    <ItemsControl ItemsSource="{Binding AutoCompleteOffPrs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:PullRequestItem">
                                                <views:PrCardView DataContext="{Binding}"
                                                                  AlertNote="Autocomplete not set"
                                                                  AlertBrush="#FFDD6600"
                                                                  OpenCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenInBrowserCommand}"
                                                                  AcknowledgeCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).TogglePrAcknowledgedCommand}"
                                                                  CopyLinkCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPrLinkCommand}"
                                                                  CopyReferenceCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPrReferenceCommand}"
                                                                  CopyTitleCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPrTitleCommand}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- ✅ Awaiting your review -->
                            <Grid Margin="8,8,8,4" ColumnDefinitions="Auto,*,Auto"
                                  IsVisible="{Binding HasReviewSection}">
                                <TextBlock Text="Awaiting your review" FontWeight="SemiBold" FontSize="14"
                                           Opacity="0.7" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="2" IsChecked="{Binding ShowApproved}"
                                              FontSize="12" Padding="8,3"
                                              VerticalAlignment="Center"
                                              IsVisible="{Binding HasHiddenApproved}"
                                              ToolTip.Tip="Show/hide PRs you've already approved">
                                    <ToggleButton.Content>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="✅"/>
                                            <TextBlock Text="{Binding HiddenApprovedCount, StringFormat={}{0} approved}"/>
                                        </StackPanel>
                                    </ToggleButton.Content>
                                </ToggleButton>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding ReadyToReviewPrs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PullRequestItem">
                                        <views:PrCardView DataContext="{Binding}"
                                                          OpenCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenInBrowserCommand}"
                                                          AcknowledgeCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).TogglePrAcknowledgedCommand}"
                                                          CopyLinkCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPrLinkCommand}"
                                                          CopyReferenceCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPrReferenceCommand}"
                                                          CopyTitleCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPrTitleCommand}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 📤 My active PRs -->
                            <TextBlock Text="My active PRs" FontWeight="SemiBold" FontSize="14"
                                       Margin="8,16,0,4" Opacity="0.7"
                                       IsVisible="{Binding HasMyActivePrs}"/>

                            <ItemsControl ItemsSource="{Binding MyActivePrs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PullRequestItem">
                                        <views:PrCardView DataContext="{Binding}" Opacity="0.85"
                                                          OpenCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenInBrowserCommand}"
                                                          CopyLinkCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPrLinkCommand}"
                                                          CopyReferenceCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPrReferenceCommand}"
                                                          CopyTitleCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPrTitleCommand}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ✓ Acknowledged — pulled out of priority sections, neutral styling -->
                            <TextBlock Text="✓ Acknowledged" FontWeight="SemiBold" FontSize="14"
                                       Margin="8,16,0,4" Opacity="0.6"
                                       IsVisible="{Binding HasAcknowledged}"/>

                            <ItemsControl ItemsSource="{Binding AcknowledgedPrs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PullRequestItem">
                                        <views:PrCardView DataContext="{Binding}" Opacity="0.75"
                                                          OpenCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenInBrowserCommand}"
                                                          AcknowledgeCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).TogglePrAcknowledgedCommand}"
                                                          CopyLinkCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPrLinkCommand}"
                                                          CopyReferenceCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPrReferenceCommand}"
                                                          CopyTitleCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPrTitleCommand}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding AcknowledgedBuilds}" Margin="4,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:BuildItem">
                                        <views:BuildCardView DataContext="{Binding}" Opacity="0.75"
                                                             OpenCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenBuildInBrowserCommand}"
                                                             OpenRetryCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenRetryBuildCommand}"
                                                             AcknowledgeCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ToggleBuildAcknowledgedCommand}"
                                                             CopyLinkCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyBuildLinkCommand}"
                                                             CopyBranchCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyBuildBranchCommand}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock Grid.Row="2" FontSize="10" Opacity="0.45"
                                   Margin="8,4,8,6" TextTrimming="CharacterEllipsis"
                                   Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AdoPaneStatus}"/>
                    </Grid>
                </Border>

                    <Border Grid.Row="1" MaxHeight="300" Margin="4" Padding="2" CornerRadius="6"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0" Text="BUILDS" FontSize="12"
                                   FontWeight="SemiBold" Opacity="0.55"
                                   Margin="8,6,8,4"/>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                            <!-- 🔴 Build failures (critical — no retry underway) -->
                            <Border IsVisible="{Binding HasFailedBuilds}" Margin="4" Padding="10" CornerRadius="6"
                                    Background="#44FF2200" BorderBrush="#AAFF2200" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="🔴 Build failures" FontWeight="SemiBold" FontSize="14"
                                               Foreground="#FFCC2200"/>
                                    <ItemsControl ItemsSource="{Binding FailedBuilds}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:BuildItem">
                                                <views:BuildCardView DataContext="{Binding}"
                                                                     OpenCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenBuildInBrowserCommand}"
                                                                     AcknowledgeCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ToggleBuildAcknowledgedCommand}"
                                                                     CopyLinkCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyBuildLinkCommand}"
                                                                     CopyBranchCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyBuildBranchCommand}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 🟠 Build failures (retry in progress — de-escalated) -->
                            <Border IsVisible="{Binding HasRetryingBuilds}" Margin="4" Padding="10" CornerRadius="6"
                                    Background="#44FF8800" BorderBrush="#AAFF8800" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="⚠ Build failures (retrying)" FontWeight="SemiBold" FontSize="14"
                                               Foreground="#FFDD6600"/>
                                    <ItemsControl ItemsSource="{Binding RetryingBuilds}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:BuildItem">
                                                <views:BuildCardView DataContext="{Binding}"
                                                                     OpenCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenBuildInBrowserCommand}"
                                                                     OpenRetryCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenRetryBuildCommand}"
                                                                     CopyLinkCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyBuildLinkCommand}"
                                                                     CopyBranchCommand="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyBuildBranchCommand}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock Grid.Row="2" FontSize="10" Opacity="0.45"
                                   Margin="8,4,8,6" TextTrimming="CharacterEllipsis"
                                   Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AdoPaneStatus}"/>
                    </Grid>
                </Border>
                </Grid>

                <Border Margin="4" Padding="2" CornerRadius="6"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <!--
                        Raised items scroll; the per-source summary underneath does not. The
                        summary is how you tell quiet from broken, so it must never be the thing
                        that scrolls out of sight.
                    -->
                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="8,4,8,4">
                            <TextBlock Text="CRASHES" FontSize="12"
                                       FontWeight="SemiBold" Opacity="0.55"
                                       VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="2" FontSize="11" Padding="6,2"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ShowMutedCrashes}"
                                          IsVisible="{Binding HasMutedCrashes}"
                                          ToolTip.Tip="Show the ones you have muted">
                                <ToggleButton.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="🔇"/>
                                        <TextBlock Text="{Binding MutedCrashCount}"/>
                                    </StackPanel>
                                </ToggleButton.Content>
                            </ToggleButton>
                        </Grid>

                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding CrashActions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:SentryIssueItem">
                                            <views:SentryIssueCardView DataContext="{Binding}"
                                                                       OpenCommand="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenSentryIssueCommand}"
                                                                       MuteCommand="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleSentryIssueMutedCommand}"
                                                                       DismissCommand="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DismissSentryIssueCommand}"
                                                                       CopyLinkCommand="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyCrashLinkCommand}"
                                                                       CopyIdCommand="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyCrashIdCommand}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock IsVisible="{Binding !CrashActions.Count}" Margin="8,10"
                                           FontSize="12" Opacity="0.45" TextWrapping="Wrap"
                                           Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CrashEmptyText}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2">
                            <Separator Margin="8,2,8,2"/>
                            <ItemsControl ItemsSource="{Binding CrashSummaries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SourceSummary">
                                        <Button Background="Transparent" BorderThickness="0"
                                                Padding="8,5" Margin="0,1"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenSummaryCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Open this project in Sentry">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Fill="#FFE2A03C" IsVisible="{Binding HasFlagged}"/>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Fill="#FF3FA34D" IsVisible="{Binding !HasFlagged}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Line}" FontSize="11"
                                                       Opacity="0.6" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            <TextBlock Grid.Column="3" Text="↗" FontSize="11" Opacity="0.5"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       IsVisible="{Binding HasUrl}"/>
                                        </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Grid.Row="3" FontSize="10" Opacity="0.45"
                                   Margin="8,4,8,6" TextTrimming="CharacterEllipsis"
                                   Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SentryPaneStatus}"/>
                    </Grid>
                </Border>

                <Border Margin="4" Padding="2" CornerRadius="6"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <!--
                        Raised items scroll; the per-source summary underneath does not. The
                        summary is how you tell quiet from broken, so it must never be the thing
                        that scrolls out of sight.
                    -->
                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="8,4,8,4">
                            <TextBlock Text="SERVICES" FontSize="12"
                                       FontWeight="SemiBold" Opacity="0.55"
                                       VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="2" FontSize="11" Padding="6,2"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ShowMutedServices}"
                                          IsVisible="{Binding HasMutedServices}"
                                          ToolTip.Tip="Show the ones you have muted">
                                <ToggleButton.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="🔇"/>
                                        <TextBlock Text="{Binding MutedServiceCount}"/>
                                    </StackPanel>
                                </ToggleButton.Content>
                            </ToggleButton>
                        </Grid>

                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding ServiceActions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ServiceFinding">
                                            <views:ServiceFindingCardView DataContext="{Binding}"
                                                                          MuteCommand="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleServiceFindingMutedCommand}"
                                                                          OpenCommand="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenServiceFindingCommand}"
                                                                          DismissCommand="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DismissServiceFindingCommand}"
                                                                          IgnoreCommand="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IgnoreServiceFindingCommand}"
                                                                          CopyQueryCommand="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyFindingQueryCommand}"
                                                                          ShowSuppressedCommand="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowSuppressedCommand}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock IsVisible="{Binding !ServiceActions.Count}" Margin="8,10"
                                           FontSize="12" Opacity="0.45" TextWrapping="Wrap"
                                           Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ServiceEmptyText}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2">
                            <Separator Margin="8,2,8,2"/>
                            <ItemsControl ItemsSource="{Binding ServiceSummaries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SourceSummary">
                                        <Button Background="Transparent" BorderThickness="0"
                                                Padding="8,5" Margin="0,1"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                IsEnabled="{Binding HasUrl}"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenSummaryCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Open this resource in the Azure portal">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Fill="#FFE2A03C" IsVisible="{Binding HasFlagged}"/>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Fill="#FF3FA34D" IsVisible="{Binding !HasFlagged}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Line}" FontSize="11"
                                                       Opacity="0.6" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            <TextBlock Grid.Column="3" Text="↗" FontSize="11" Opacity="0.5"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       IsVisible="{Binding HasUrl}"/>
                                        </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="8,4,8,6" Spacing="2">
                            <TextBlock FontSize="10" Opacity="0.45" TextTrimming="CharacterEllipsis"
                                       Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ServicePaneStatus}"/>

                            <!--
                                The way in to what is hidden. It belongs on the pane rather than
                                only on a card, because the case that matters most is an empty
                                pane: there is no card to reach a menu from, and "nothing wrong"
                                and "everything filtered" look identical.
                            -->
                            <Button Padding="0" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" HorizontalAlignment="Left"
                                    IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).HasSuppressed}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowSuppressedCommand}"
                                    ToolTip.Tip="See what the rules are keeping off this pane">
                                <TextBlock FontSize="10" Foreground="#FF7FB2E5"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SuppressedLink}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
        </UniformGrid>

        <!-- ═══ STATUS BAR ═══ -->
        <Border Grid.Row="3" Padding="12,6" Background="{DynamicResource SystemAltHighColor}">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.7"/>
        </Border>
    </Grid>
</Window>
